{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/microcosmos-lib",
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": ["src/lib/styles"]
  },
  "assets": [
    {
      "input": "src/assets",
      "glob": "**/*",
      "output": "assets"
    },
    {
      "input": "src/lib/components/icons/icons",
      "glob": "**/*.svg",
      "output": "icons"
    }
  ]
}
