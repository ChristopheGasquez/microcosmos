{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "microcosmos-lib": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/microcosmos-lib",
      "sourceRoot": "projects/microcosmos-lib/src",
      "prefix": "mcs",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/microcosmos-lib/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/microcosmos-lib/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/microcosmos-lib/tsconfig.spec.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/microcosmos-lib/.storybook",
            "browserTarget": "microcosmos-lib:build",
            "compodoc": false,
            "port": 6006,
            "styles": [
              "projects/microcosmos-lib/src/lib/styles"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/microcosmos-lib/.storybook",
            "browserTarget": "microcosmos-lib:build",
            "compodoc": false,
            "outputDir": "dist/storybook/microcosmos-lib"
          }
        }
      }
    },
    "microcosmos-demo": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/microcosmos-demo",
      "sourceRoot": "projects/microcosmos-demo/src",
      "prefix": "mcs-demo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/microcosmos-demo/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/microcosmos-demo/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/microcosmos-demo/public"
              }
            ],
            "styles": [
              "projects/microcosmos-demo/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/microcosmos-lib/src/lib/styles"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "microcosmos-demo:build:production"
            },
            "development": {
              "buildTarget": "microcosmos-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/microcosmos-demo/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/microcosmos-demo/public"
              }
            ],
            "styles": [
              "projects/microcosmos-demo/src/styles.scss"
            ]
          }
        }
      }
    }
  }
}
